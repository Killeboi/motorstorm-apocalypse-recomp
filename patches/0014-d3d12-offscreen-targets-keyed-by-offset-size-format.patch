+/* MotorStorm port: the pool is keyed by (offset, size, format), not by offset alone. The title
+ * reuses one VRAM offset for several surfaces inside a single frame (0x021E0000 is a 320x270
+ * RGBA8 target in one pass and a 1280x1080 one a dozen ops later). With one resource per
+ * offset the pre-pass recreated it for every such draw (a wait_for_gpu each time) and the last
+ * size/format won, so the other passes drew through pipelines of the wrong format (debug layer
+ * message 613) into a surface of the wrong size. RT_KEY_OFFSET=1 restores the old behaviour. */
+static u32 s_off_rt_stamp = 0;
+static int off_rt_by_offset_only(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("RT_KEY_OFFSET"); v = e ? atoi(e) : 0; }
+    return v;
+}
+/* By offset alone: the most recently targeted surface at that offset. */
 static int off_rt_find(u32 off)
 {
     if (!off) return -1;
+    int best = -1;
     for (int i = 0; i < MAX_OFF_RTS; i++)
-        if (s_d3d.off_rt[i].res && s_d3d.off_rt[i].off == off) return i;
+        if (s_d3d.off_rt[i].res && s_d3d.off_rt[i].off == off &&
+            (best < 0 || s_d3d.off_rt[i].stamp > s_d3d.off_rt[best].stamp)) best = i;
+    return best;
+}
+static int off_rt_find_exact(u32 off, u32 w, u32 h, u32 dxgi)
+{
+    if (!off) return -1;
+    for (int i = 0; i < MAX_OFF_RTS; i++)
+        if (s_d3d.off_rt[i].res && s_d3d.off_rt[i].off == off && s_d3d.off_rt[i].w == w &&
+            s_d3d.off_rt[i].h == h && s_d3d.off_rt[i].dxgi == dxgi) return i;
     return -1;
 }
+/* A surface read as a texture: the newest one at that offset with the texture's size and
+ * format class (float texture <-> float target), else same size, else the newest at that offset. */
+static int off_rt_find_tex(u32 off, u32 w, u32 h, u32 texfmt)
+{
+    if (!off) return -1;
+    if (off_rt_by_offset_only()) return off_rt_find(off);
+    const u32 bf = texfmt & 0x9F;
+    const int tex_float = (bf == 0x9A || bf == 0x9B || bf == 0x9C);   /* W16Z16Y16X16F / W32..F / X32F */
+    int best = -1, best_fmt = -1;
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
+        const OffRT* r = &s_d3d.off_rt[i];
+        if (!r->res || r->off != off || r->w != w || r->h != h) continue;
+        if (best < 0 || r->stamp > s_d3d.off_rt[best].stamp) best = i;
+        const int rt_float = (r->dxgi != (u32)DXGI_FORMAT_R8G8B8A8_UNORM);
+        if (rt_float == tex_float && (best_fmt < 0 || r->stamp > s_d3d.off_rt[best_fmt].stamp)) best_fmt = i;
+    }
+    return best_fmt >= 0 ? best_fmt : best >= 0 ? best : off_rt_find(off);
+}
+
+static DXGI_FORMAT off_rt_want_fmt(u32 rsx_fmt)
+{
+    static int f8 = -1;
+    if (f8 < 0) { const char* e = getenv("RT_FORCE_RGBA8"); f8 = e ? atoi(e) : 0; }
+    return f8 ? DXGI_FORMAT_R8G8B8A8_UNORM : rsx_surface_dxgi(rsx_fmt);
+}
+/* The pool slot a draw renders into (the one the pre-pass made for exactly this surface). */
+static int dr_rt_slot(const D3D12DrawRecord* dr, u32 off)
+{
+    if (off_rt_by_offset_only()) return off_rt_find(off);
+    return off_rt_find_exact(off, dr->rt_w ? dr->rt_w : s_d3d.width,
+                             dr->rt_h ? dr->rt_h : s_d3d.height, (u32)off_rt_want_fmt(dr->rt_fmt));
+}
 
