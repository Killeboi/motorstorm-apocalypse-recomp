+/* MotorStorm port: GPU-side stand-in for "copy the scene to main memory, post-process it on the
+ * SPU, blit it to the display buffer". The title renders its scene into an offscreen target,
+ * moves it to main memory with NV3089 tiles, runs MLAA there on the SPU and blits the result
+ * (scaled 1280x1080 -> 1280x720) into the display buffer, then draws the UI on top. The scene
+ * only exists on the GPU here, so the guest-memory chain moves zeros and the backdrop is black.
+ * cellGcmSys (GCM_RT_BLIT_COMPOSITE=1) recognises the final blit and calls this: at the same
+ * place in the op order, draw that target, scaled, into the backbuffer.
+ * s_sblit_at is the number of ops recorded when the blit came; 0xFFFFFFFF = none pending. */
+static u32 s_sblit_src = 0, s_sblit_at = 0xFFFFFFFFu;
+int rsx_d3d12_offscreen_rt_exists(u32 raw_off) { return off_rt_find(raw_off) >= 0; }
+void rsx_d3d12_blit_rt_to_display(u32 raw_off)
+{
+    s_sblit_src = raw_off;
+    s_sblit_at  = s_d3d.draw_count;
+}
+static int sblit_init(void)
+{
+    if (s_d3d.sblit_pso) return 1;
+    static int failed = 0;
+    if (failed) return 0;
+    failed = 1;
+    static const char vs[] =
+        "struct O { float4 p : SV_Position; float2 uv : TEXCOORD0; };\n"
+        "O main(uint id : SV_VertexID) {\n"
+        "    O o; float2 t = float2((id << 1) & 2, id & 2);\n"
+        "    o.uv = t; o.p = float4(t * float2(2, -2) + float2(-1, 1), 0, 1); return o;\n"
+        "}\n";
+    static const char ps[] =
+        "Texture2D src : register(t0);\n"
+        "SamplerState lin : register(s0);\n"
+        "float4 main(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {\n"
+        "    return float4(src.SampleLevel(lin, uv, 0).rgb, 1);\n"
+        "}\n";
+    ID3DBlob *vb = NULL, *pb = NULL, *err = NULL;
+    if (FAILED(D3DCompile(vs, sizeof vs - 1, "sblit_vs", NULL, NULL, "main", "vs_5_0", 0, 0, &vb, &err)) ||
+        FAILED(D3DCompile(ps, sizeof ps - 1, "sblit_ps", NULL, NULL, "main", "ps_5_0", 0, 0, &pb, &err))) {
+        printf("[D3D12] scene blit shader: %s%c", err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?", 10);
+        return 0;
+    }
+    D3D12_DESCRIPTOR_RANGE rg = {0};
+    rg.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    rg.NumDescriptors = 1;
+    D3D12_ROOT_PARAMETER rp = {0};
+    rp.ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    rp.DescriptorTable.NumDescriptorRanges = 1;
+    rp.DescriptorTable.pDescriptorRanges = &rg;
+    rp.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_STATIC_SAMPLER_DESC ss = {0};
+    ss.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+    ss.AddressU = ss.AddressV = ss.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    ss.MaxLOD = D3D12_FLOAT32_MAX;
+    ss.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_ROOT_SIGNATURE_DESC rd = {0};
+    rd.NumParameters = 1; rd.pParameters = &rp;
+    rd.NumStaticSamplers = 1; rd.pStaticSamplers = &ss;
+    ID3DBlob* sig = NULL;
+    if (FAILED(D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err)) ||
+        FAILED(s_d3d.device->lpVtbl->CreateRootSignature(s_d3d.device, 0, sig->lpVtbl->GetBufferPointer(sig),
+               sig->lpVtbl->GetBufferSize(sig), &IID_ID3D12RootSignature, (void**)&s_d3d.sblit_rs)))
+        return 0;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+    pd.pRootSignature = s_d3d.sblit_rs;
+    pd.VS.pShaderBytecode = vb->lpVtbl->GetBufferPointer(vb);
+    pd.VS.BytecodeLength  = vb->lpVtbl->GetBufferSize(vb);
+    pd.PS.pShaderBytecode = pb->lpVtbl->GetBufferPointer(pb);
+    pd.PS.BytecodeLength  = pb->lpVtbl->GetBufferSize(pb);
+    pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    pd.RasterizerState.DepthClipEnable = TRUE;
+    pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    pd.SampleMask = UINT_MAX;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pd.NumRenderTargets = 1;
+    pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+    pd.SampleDesc.Count = 1;
+    if (FAILED(s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+            s_d3d.device, &pd, &IID_ID3D12PipelineState, (void**)&s_d3d.sblit_pso)))
+        return 0;
+    failed = 0;
+    return 1;
+}
+/* Draw offscreen target `raw_off` over the whole backbuffer. Leaves the guest path's root
+ * signature, heaps and targets unbound (the caller rebinds, as after ds_convert). Returns 1
+ * if it drew. */
+static int sblit_draw(u32 raw_off, D3D12_CPU_DESCRIPTOR_HANDLE bb_rtv)
+{
+    const int rt = off_rt_find(raw_off);
+    if (rt < 0 || !s_d3d.off_rt[rt].res || !sblit_init()) return 0;
+    ID3D12GraphicsCommandList* cl = s_d3d.cmd_list;
+    { static int n = 0;
+      if (PS3_LOG_FIRST(n, 3))
+          fprintf(stderr, "[D3D12] scene blit: rt 0x%08X %ux%u dxgi=%u -> backbuffer%c", raw_off,
+                  s_d3d.off_rt[rt].w, s_d3d.off_rt[rt].h, s_d3d.off_rt[rt].dxgi, 10); }
+    off_rt_transition(rt, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    cl->lpVtbl->OMSetRenderTargets(cl, 1, &bb_rtv, FALSE, NULL);
+    D3D12_VIEWPORT vp = {0, 0, (float)s_d3d.width, (float)s_d3d.height, 0.0f, 1.0f};
+    D3D12_RECT sc = {0, 0, (LONG)s_d3d.width, (LONG)s_d3d.height};
+    cl->lpVtbl->RSSetViewports(cl, 1, &vp);
+    cl->lpVtbl->RSSetScissorRects(cl, 1, &sc);
+    cl->lpVtbl->SetGraphicsRootSignature(cl, s_d3d.sblit_rs);
+    cl->lpVtbl->SetPipelineState(cl, s_d3d.sblit_pso);
+    ID3D12DescriptorHeap* hp[] = { s_d3d.srv_heap };
+    cl->lpVtbl->SetDescriptorHeaps(cl, 1, hp);
+    D3D12_GPU_DESCRIPTOR_HANDLE gh;
+    s_d3d.srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &gh);
+    gh.ptr += (u64)(RT_SRV_BASE + rt) * s_d3d.srv_inc;
+    cl->lpVtbl->SetGraphicsRootDescriptorTable(cl, 0, gh);
+    cl->lpVtbl->IASetPrimitiveTopology(cl, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    cl->lpVtbl->DrawInstanced(cl, 3, 1, 0, 0);
+    return 1;
+}
