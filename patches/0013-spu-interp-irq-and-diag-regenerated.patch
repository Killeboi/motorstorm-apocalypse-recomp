diff --git a/runtime/spu/spu_interp.c b/runtime/spu/spu_interp.c
index 77f8637..959e3d3 100644
--- a/runtime/spu/spu_interp.c
+++ b/runtime/spu/spu_interp.c
@@ -510,6 +510,42 @@ uint32_t spu_interp_run_until(spu_context* ctx, uint32_t start_lsa, uint32_t sto
         /* ponytail: pc-only match; a recursive call through the same site would stop early -- compare r1 too if one shows up. */
         if (ctx->image_id >= 0 && ((stop_lsa && ctx->pc == stop_lsa) || spu_lifted_lookup(ctx, ctx->pc))) { g_spu_interp_steps = steps; g_spu_interp_last_pc = ctx->pc; return ctx->pc; }  /* rejoin fast path */
         g_spu_interp_last_pc = ctx->pc;
+        /* Asynchronous SPU interrupts in interpreted code (MotorStorm port). The lifted
+         * dispatcher takes a pending interrupt after every transfer while int_enable is set;
+         * the interpreter never checked, so a bie/bid window (the Wws job-manager PM spins in
+         * one at LS 0x2D00 waiting for its DMA-list stall-and-notify interrupt) could never
+         * fire. SPU_INTERP_NOIRQ=1 restores the old behaviour. */
+        if (ctx->int_enable && (ctx->event_status & ctx->event_mask)) {
+            static int s_ni = -1; if (s_ni < 0) s_ni = getenv("SPU_INTERP_NOIRQ") ? 1 : 0;
+            if (!s_ni) {
+                extern void (*spu_take_interrupt(spu_context*, void (*)(spu_context*)))(spu_context*);
+                static volatile long s_tk = 0;
+                const uint32_t at = ctx->pc;
+                spu_take_interrupt(ctx, 0);
+                if (!ctx->int_enable && s_tk++ < 20)
+                    fprintf(stderr, "[spu-interp] interrupt taken at LS 0x%05X -> 0x%05X\n", at, ctx->pc & SPU_LS_MASK);
+                if (!ctx->int_enable) continue;   /* taken: run the handler from ctx->pc */
+            }
+        }
+        /* SPU_INTERP_PCTRACE=<lo>-<hi>[,<file>]: log every interpreted block entry (pc not the
