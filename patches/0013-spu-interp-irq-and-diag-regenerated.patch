+         * <file> (default spu_pctrace.txt), at most SPU_INTERP_PCTRACE_MAX lines (default 400000).
+         * MotorStorm port: follow the Wws job-manager PM (PS3_PM_NOLIFT=wwsjob). */
+        { static int s_pt = -1; static uint32_t s_lo, s_hi; static FILE* s_pf; static long long s_left;
+          static SPU_THREAD_LOCAL uint32_t t_prev = 0xFFFFFFFFu;
+          if (s_pt < 0) {
+              const char* e = getenv("SPU_INTERP_PCTRACE"); s_pt = 0;
+              if (e) { char* d; s_lo = (uint32_t)strtoul(e, &d, 16); if (*d == '-') s_hi = (uint32_t)strtoul(d + 1, &d, 16);
+                       const char* fn = (*d == ',') ? d + 1 : "spu_pctrace.txt"; s_pf = fopen(fn, "w");
+                       const char* m = getenv("SPU_INTERP_PCTRACE_MAX"); s_left = m ? atoll(m) : 400000; s_pt = s_pf ? 1 : 0; } }
+          if (s_pt && s_left > 0 && ctx->pc >= s_lo && ctx->pc < s_hi && ctx->pc != t_prev + 4) {
+              s_left--;
+              fprintf(s_pf, "%05X spu=%X r3=%08X r4=%08X r5=%08X r6=%08X lr=%05X\n", ctx->pc, ctx->spu_id,
+                      ctx->gpr[3]._u32[0], ctx->gpr[4]._u32[0], ctx->gpr[5]._u32[0], ctx->gpr[6]._u32[0],
+                      ctx->gpr[0]._u32[0] & SPU_LS_MASK);
+              if ((s_left & 1023) == 0) fflush(s_pf);
+          }
+          t_prev = ctx->pc; }
         if (_g1>0) {
             int inr = (ctx->pc >= 0x26E80u && ctx->pc < 0x26F14u);
             if (inr) { _g1in = 1; }
