+/* Depth bounds test (RSX 0x380-0x388): MotorStorm restricts each sun/shadow-cascade pass to its depth slice
+ * with it. Ignored, every cascade pass lit the whole screen. Bit 50 of zs_key selects a PSO with
+ * DepthBoundsTestEnable; the bounds are set per draw with OMSetDepthBounds. DBT_OFF=1 = old behaviour. */
+static void rec_dbt(D3D12DrawRecord* dr)
+{
+    static int off = -1; if (off < 0) off = getenv("DBT_OFF") ? 1 : 0;
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (off || !st || !st->dbt_enable) return;
+    dr->zs_key |= 1ull << 50; dr->dbt_min = st->dbt_min; dr->dbt_max = st->dbt_max;
+    { static int n = 0; float a, b; memcpy(&a, &st->dbt_min, 4); memcpy(&b, &st->dbt_max, 4);
+      if (PS3_LOG_FIRST(n, 8)) fprintf(stderr, "[DBT] depth bounds %.5f..%.5f%c", a, b, 10); }
+}
