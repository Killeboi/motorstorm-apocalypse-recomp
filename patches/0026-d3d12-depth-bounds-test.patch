+/* A graphics PSO with DepthBoundsTestEnable (only reachable through the pipeline-state stream API). */
+static void pss_push(unsigned char* buf, size_t* off, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE type, const void* v, size_t sz, size_t al)
+{
+    size_t o = (*off + 7) & ~(size_t)7;
+    memcpy(buf + o, &type, sizeof type);
+    size_t vo = (o + sizeof type + (al - 1)) & ~(al - 1);
+    memcpy(buf + vo, v, sz);
+    *off = (vo + sz + 7) & ~(size_t)7;
+}
+static HRESULT create_pso_dbt(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd, ID3D12PipelineState** out)
+{
+    static ID3D12Device2* dev2 = NULL; static int tried = 0;
+    if (!tried) { tried = 1; s_d3d.device->lpVtbl->QueryInterface(s_d3d.device, &IID_ID3D12Device2, (void**)&dev2); }
+    if (!dev2) return E_NOINTERFACE;
+    unsigned char buf[2048]; size_t off = 0;
+    D3D12_DEPTH_STENCIL_DESC1 ds1;
+    ds1.DepthEnable = pd->DepthStencilState.DepthEnable; ds1.DepthWriteMask = pd->DepthStencilState.DepthWriteMask;
+    ds1.DepthFunc = pd->DepthStencilState.DepthFunc; ds1.StencilEnable = pd->DepthStencilState.StencilEnable;
+    ds1.StencilReadMask = pd->DepthStencilState.StencilReadMask; ds1.StencilWriteMask = pd->DepthStencilState.StencilWriteMask;
+    ds1.FrontFace = pd->DepthStencilState.FrontFace; ds1.BackFace = pd->DepthStencilState.BackFace;
+    ds1.DepthBoundsTestEnable = TRUE;
+    struct D3D12_RT_FORMAT_ARRAY rtf; memset(&rtf, 0, sizeof rtf);
+    rtf.NumRenderTargets = pd->NumRenderTargets;
+    for (UINT i = 0; i < 8; i++) rtf.RTFormats[i] = pd->RTVFormats[i];
+    pss_push(buf, &off, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_ROOT_SIGNATURE, &pd->pRootSignature, sizeof(void*), 8);
+    pss_push(buf, &off, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_VS, &pd->VS, sizeof pd->VS, 8);
+    pss_push(buf, &off, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PS, &pd->PS, sizeof pd->PS, 8);
+    pss_push(buf, &off, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_BLEND, &pd->BlendState, sizeof pd->BlendState, 4);
+    pss_push(buf, &off, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_SAMPLE_MASK, &pd->SampleMask, sizeof pd->SampleMask, 4);
+    pss_push(buf, &off, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RASTERIZER, &pd->RasterizerState, sizeof pd->RasterizerState, 4);
+    pss_push(buf, &off, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL1, &ds1, sizeof ds1, 4);
+    pss_push(buf, &off, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_INPUT_LAYOUT, &pd->InputLayout, sizeof pd->InputLayout, 8);
+    pss_push(buf, &off, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_IB_STRIP_CUT_VALUE, &pd->IBStripCutValue, sizeof pd->IBStripCutValue, 4);
+    pss_push(buf, &off, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PRIMITIVE_TOPOLOGY, &pd->PrimitiveTopologyType, sizeof pd->PrimitiveTopologyType, 4);
+    pss_push(buf, &off, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_RENDER_TARGET_FORMATS, &rtf, sizeof rtf, 4);
+    pss_push(buf, &off, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_DEPTH_STENCIL_FORMAT, &pd->DSVFormat, sizeof pd->DSVFormat, 4);
+    pss_push(buf, &off, D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_SAMPLE_DESC, &pd->SampleDesc, sizeof pd->SampleDesc, 4);
+    D3D12_PIPELINE_STATE_STREAM_DESC sd; sd.SizeInBytes = off; sd.pPipelineStateSubobjectStream = buf;
+    return dev2->lpVtbl->CreatePipelineState(dev2, &sd, &IID_ID3D12PipelineState, (void**)out);
+}
