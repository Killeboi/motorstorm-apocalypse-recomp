+/* PPU_CAS_LOCKLINE (default on): serialize every PPU store-conditional with SPU lock-line
+ * commits. See the comment in ppu_stwcx32. */
+static int ppu_cas_lockline_always(void)
+{
+    static int s = -1;
+    if (s < 0) { const char* e = getenv("PPU_CAS_LOCKLINE"); s = (e && e[0] == '0') ? 0 : 1; }
+    return s;
+}
 extern "C" int ppu_stwcx32(uint64_t ea, uint32_t expected, uint32_t val)
 {
     uint32_t exp_raw = __builtin_bswap32(expected);
@@ -1049,7 +1057,14 @@ extern "C" int ppu_stwcx32(uint64_t ea, uint32_t expected, uint32_t val)
      * notify: the same serialization the coherent stores use, so a PPU commit
      * cannot land inside an SPU PUTLLC's compare/commit window (nor the
      * reverse), and the reserving SPU gets its lost-reservation event. */
-    int coh = spu_coh_is_reserved((uint32_t)ea);
+    /* Take the lock-line lock for EVERY store-conditional, not only when an SPU has the
+     * line reserved at this instant: that check is unlocked, so an SPU could GETLLAR
+     * right after it and its PUTLLC (memcmp + memcpy under the lock) could then
+     * overwrite this CAS between its compare and its copy -- a lost update. MotorStorm's
+     * SPURS event flags (PPU ldarx/stdcx vs SPU GETLLAR/PUTLLC on the same line) lost
+     * ppuWaitMask/ppuPendingRecv updates that way and cellSpursEventFlagWait returned
+     * CELL_SPURS_TASK_ERROR_BUSY. PPU_CAS_LOCKLINE=0 restores the old fast path. */
+    int coh = ppu_cas_lockline_always() || spu_coh_is_reserved((uint32_t)ea);
     /* SPU_PUTLLC_WHY=1: count PPU commits that land on a line an SPU has
      * reserved. If an SPU's PUTLLC never succeeds for "no reservation", the
      * PPU hammering the same 128-byte line is one of only two agents that can
@@ -1136,7 +1151,7 @@ extern "C" int ppu_stdcx64(uint64_t ea, uint64_t expected, uint64_t val)
     volatile LONG* L = resv_slot(ea);   /* ea and ea+4 share a 16-byte-block slot */
     resv_lock(L);
     if (self && self->reserve_addr != (uint32_t)ea) { resv_unlock(L); return 0; }
-    int coh = spu_coh_is_reserved((uint32_t)ea);
+    int coh = ppu_cas_lockline_always() || spu_coh_is_reserved((uint32_t)ea);   /* see ppu_stwcx32 */
     if (coh) spu_lockline_lock();
     if (coh && self && self->reserve_addr != (uint32_t)ea) {   /* as in ppu_stwcx32 */
         spu_lockline_unlock(); resv_unlock(L); return 0;
