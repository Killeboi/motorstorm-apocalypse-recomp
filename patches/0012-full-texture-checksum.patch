+    /* MotorStorm port: hash EVERY byte. The old sparse walk (1024 samples) stepped by exactly
+     * one row on a 2048x1024 B8 glyph atlas, so it only ever read column 0 and never saw new
+     * glyphs being rasterised: the menu text came out with most letters missing ("A / A IN"
+     * for "PLAY / PLAY IN 3D"). TEX_CSUM_SPARSE=1 restores the old walk. */
+    static int sparse = -1;
+    if (sparse < 0) { const char* e = getenv("TEX_CSUM_SPARSE"); sparse = e ? atoi(e) : 0; }
+    if (sparse) {
+        u32 h = 2166136261u;
+        u32 step = nbytes > 4096u ? nbytes / 1024u : 4u;
+        for (u32 i = 0; i + 3 < nbytes; i += step) {
+            u32 w32; memcpy(&w32, base + i, sizeof w32);
+            h ^= w32; h *= 16777619u;
+        }
+        return h;
+    }
+    const unsigned long long K = 0x9FB21C651E98DF25ull;
+    unsigned long long a = 0x9E3779B97F4A7C15ull, b = 0xC2B2AE3D27D4EB4Full,
+                       c = 0x165667B19E3779F9ull, d = 0x27D4EB2F165667C5ull;
+    u32 i = 0;
+    for (; i + 32 <= nbytes; i += 32) {
+        unsigned long long w[4]; memcpy(w, base + i, 32);
+        a = (a ^ w[0]) * K; a ^= a >> 29;
+        b = (b ^ w[1]) * K; b ^= b >> 29;
+        c = (c ^ w[2]) * K; c ^= c >> 29;
+        d = (d ^ w[3]) * K; d ^= d >> 29;
+    }
+    for (; i < nbytes; i++) { a = (a ^ base[i]) * K; a ^= a >> 29; }
+    a ^= (b * 3) ^ (c * 5) ^ (d * 7); a ^= a >> 32;
+    return (u32)a ^ (u32)(a >> 17);
 }
 
