+/* SPU_TASKSET_FORCE_HLE=<hex EA>[,<hex EA>...]: tasksets whose task syscalls (LS 0xA70)
+ * are served by the HLE below even when the real taskset policy is resident. For a title
+ * that runs an LLE SPURS kernel but has one taskset the real policy cannot yet drive here
+ * (MotorStorm: Multistream's MP3 task, taskset 0x0137A880, stops inside the policy while
+ * its code runs partly interpreted). The taskset is read from SpursTasksetContext @0x27BC. */
+int spu_taskset_force_hle(const spu_context* ctx)
+{
+    static uint32_t s_list[8]; static int s_n = -1;
+    if (s_n < 0) {
+        s_n = 0;
+        const char* e = getenv("SPU_TASKSET_FORCE_HLE");
+        while (e && *e && s_n < 8) {
+            char* end = NULL;
+            unsigned long v = strtoul(e, &end, 16);
+            if (end == e) break;
+            s_list[s_n++] = (uint32_t)v;
+            e = (*end == ',') ? end + 1 : end;
+            if (!*end) break;
+        }
+    }
+    if (!s_n) return 0;
+    const uint32_t ts = ((uint32_t)ctx->ls[0x27BC] << 24) | ((uint32_t)ctx->ls[0x27BD] << 16) |
+                        ((uint32_t)ctx->ls[0x27BE] << 8)  |  (uint32_t)ctx->ls[0x27BF];
+    for (int i = 0; i < s_n; i++) if (s_list[i] == ts) return 1;
+    return 0;
+}
