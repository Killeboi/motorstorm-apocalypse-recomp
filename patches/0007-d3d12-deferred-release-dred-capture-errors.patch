+/* MotorStorm port: say once, loudly, when the device dies. Without this the guest keeps
+ * issuing draws into a dead device and the only symptom is a frozen window. Detection lags
+ * the hang by a frame or more. With D3D12_DRED=1 each command list that did not finish is
+ * listed with how far it got. */
+static void d3d12_report_device_removed(void)
+{
+    static int s_reported = 0;
+    if (s_reported) return;
+    HRESULT rr = s_d3d.device->lpVtbl->GetDeviceRemovedReason(s_d3d.device);
+    if (rr == S_OK) return;
+    s_reported = 1;
+    fprintf(stderr, "[D3D12-LOST] device removed: reason=0x%08lX frame=%llu last_frame_draws=%u\n",
+            (long)rr, (unsigned long long)s_d3d.frame_count, s_dbg_last_draws);
+    ID3D12DeviceRemovedExtendedData* d = NULL;
+    if (SUCCEEDED(s_d3d.device->lpVtbl->QueryInterface(s_d3d.device,
+            &IID_ID3D12DeviceRemovedExtendedData, (void**)&d)) && d) {
+        D3D12_DRED_AUTO_BREADCRUMBS_OUTPUT bc = {0};
+        if (SUCCEEDED(d->lpVtbl->GetAutoBreadcrumbsOutput(d, &bc))) {
+            for (const D3D12_AUTO_BREADCRUMB_NODE* n = bc.pHeadAutoBreadcrumbNode; n; n = n->pNext) {
+                const u32 done = n->pLastBreadcrumbValue ? *n->pLastBreadcrumbValue : 0;
+                if (done >= n->BreadcrumbCount) continue;   /* this list finished */
+                u32 draws = 0;
+                for (u32 i = 0; i < done; i++)
+                    if (n->pCommandHistory[i] == D3D12_AUTO_BREADCRUMB_OP_DRAWINSTANCED ||
+                        n->pCommandHistory[i] == D3D12_AUTO_BREADCRUMB_OP_DRAWINDEXEDINSTANCED) draws++;
+                fprintf(stderr, "[D3D12-LOST] unfinished list: %u/%u ops done, %u draws done; ops around:",
+                        done, n->BreadcrumbCount, draws);
+                for (u32 i = done > 6 ? done - 6 : 0; i < done + 6 && i < n->BreadcrumbCount; i++)
+                    fprintf(stderr, " %s%d", i == done ? ">" : "", (int)n->pCommandHistory[i]);
+                fprintf(stderr, "\n");
+            }
+        } else fprintf(stderr, "[D3D12-LOST] no breadcrumbs (run with D3D12_DRED=1)\n");
+        D3D12_DRED_PAGE_FAULT_OUTPUT pf = {0};
+        if (SUCCEEDED(d->lpVtbl->GetPageFaultAllocationOutput(d, &pf))) {
+            fprintf(stderr, "[D3D12-LOST] page fault VA=0x%016llX\n", (unsigned long long)pf.PageFaultVA);
+            for (int k = 0; k < 2; k++) {
+                int shown = 0;
+                for (const D3D12_DRED_ALLOCATION_NODE* a = k ? pf.pHeadRecentFreedAllocationNode
+                                                             : pf.pHeadExistingAllocationNode;
+                     a && shown < 24; a = a->pNext, shown++)
+                    fprintf(stderr, "[D3D12-LOST] %s: type=%d name=%s\n", k ? "recently freed" : "at fault VA",
+                            (int)a->AllocationType, a->ObjectNameA ? a->ObjectNameA : "(none)");
+                if (!shown) fprintf(stderr, "[D3D12-LOST] %s: none\n", k ? "recently freed" : "at fault VA");
+            }
+        }
+        d->lpVtbl->Release(d);
+    }
+    fflush(stderr);
+}
