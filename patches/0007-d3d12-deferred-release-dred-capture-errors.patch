+/* MotorStorm port: wait_for_gpu only covers submitted work, so a resource the still-open
+ * command list refers to cannot be released on the spot: the GPU page-faults on it when the
+ * list is executed (DRED: unfinished CopyTextureRegion, fault in a recently freed resource,
+ * device hung). Hold such resources until render_frame's opening wait, when the list that
+ * used them has finished. */
+#define GFX_GRAVE_MAX 512
+static ID3D12Resource* s_gfx_grave[GFX_GRAVE_MAX];
+static u32 s_gfx_grave_n = 0;
+
+static void gfx_defer_release(ID3D12Resource* r, const char* what)
+{
+    if (!r) return;
+    { static int _n = 0;
+      if (_n < 16) { _n++;
+          fprintf(stderr, "[D3D12] deferred release of %s at frame %llu%c", what,
+                  (unsigned long long)s_d3d.frame_count, 10); } }
+    if (s_gfx_grave_n >= GFX_GRAVE_MAX) {   /* leaking is safe, releasing here is not */
+        static int _w = 0;
+        if (!_w) { _w = 1; fprintf(stderr, "[D3D12] deferred-release list full: leaking%c", 10); }
+        return;
+    }
+    s_gfx_grave[s_gfx_grave_n++] = r;
+}
+
+static void gfx_flush_deferred_releases(void)
+{
+    for (u32 i = 0; i < s_gfx_grave_n; i++)
+        s_gfx_grave[i]->lpVtbl->Release(s_gfx_grave[i]);
+    s_gfx_grave_n = 0;
+}
